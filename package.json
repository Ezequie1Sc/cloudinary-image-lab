{
  "name": "cloudinary-image-lab",
  "version": "1.0.0",
  "description": "Interactive and educational Angular 22 lab to explore, compare, and measure real Cloudinary image optimization transformations.",
  "author": "Orlando Ezequiel Salazar Cruz",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\" \"public/i18n/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\" \"public/i18n/*.json\""
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@cloudinary/ng": "^2.1.6",
    "@cloudinary/url-gen": "^1.22.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/angular": "^1.78.0",
    "@shikijs/langs": "4.6.0",
    "@shikijs/themes": "4.6.0",
    "ogl": "^1.0.11",
    "rxjs": "~7.8.2",
    "shiki": "^4.6.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.5",
    "angular-eslint": "^22.8.0",
    "eslint": "^9.39.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
